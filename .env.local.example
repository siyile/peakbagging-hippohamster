# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth (SHA-256 hex hash of your admin password)
ADMIN_PASSWORD_HASH=

# JWT secret (generate with: openssl rand -hex 32)
JWT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Cron (auto-injected by Vercel when set as project env var; required to authorize /api/cron/* requests)
CRON_SECRET=
